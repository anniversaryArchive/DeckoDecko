{
  "name": "@deckodecko/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./mocks": "./src/mocks/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "supabase gen types typescript --linked > database.types.tmp || { rm -f database.types.tmp; exit 1; }; mv database.types.tmp src/database.types.ts && prettier --write src/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.2"
  },
  "devDependencies": {
    "@deckodecko/eslint-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "happy-dom": "^21.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

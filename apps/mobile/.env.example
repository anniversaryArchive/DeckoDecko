# 로컬 개발용. 이 파일을 .env.local 로 복사하고 Supabase dev 프로젝트 값을 채운다.
# EXPO_PUBLIC_* 는 앱 번들에 그대로 들어간다. publishable key(sb_publishable_...) 외의 키는 절대 넣지 않는다.
# EAS 빌드는 이 파일이 아니라 EAS 환경변수(development / preview / production)를 쓴다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 목 데이터(메모리 저장소)로 돌리려면 mock. 비우면 Supabase 를 쓴다.
EXPO_PUBLIC_DATA_SOURCE=

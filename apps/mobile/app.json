{
  "expo": {
    "name": "DeckoDecko",
    "slug": "deckodecko",
    "version": "1.0.0",
    "scheme": "deckodecko",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9F4",
    "ios": {
      "bundleIdentifier": "com.anniversaryarchive.deckodecko",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.anniversaryarchive.deckodecko"
    },
    "locales": {
      "ko": "./locales/ko.json"
    },
    "plugins": ["expo-router", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

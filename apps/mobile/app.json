{
  "expo": {
    "name": "DeckoDecko",
    "slug": "deckodecko",
    "version": "1.0.0",
    "scheme": "deckodecko",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9F4",
    "ios": {
      "bundleIdentifier": "com.anniversaryarchive.deckodecko",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.anniversaryarchive.deckodecko"
    },
    "locales": {
      "ko": "./locales/ko.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-image-picker",
        { "photosPermission": false, "cameraPermission": false, "microphonePermission": false }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "deckodecko",
    "extra": {
      "eas": {
        "projectId": "9d3ae1b3-230e-459c-a7ad-f9f5de6a125e"
      }
    }
  }
}

{
  "name": "deckodecko",
  "private": true,
  "version": "0.0.0",
  "description": "가챠 탐색대 (DeckoDecko) 모노레포",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "turbo": "^2.11.7"
  }
}
